# Copy to .env and adjust.

# --- Database (PostgreSQL 16+ with PostGIS) ---------------------------------
# Option A — no Docker: `npm run db:local` (PGlite + PostGIS on port 5433)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Option B — Docker: `docker compose up -d`
# DATABASE_URL=postgres://sisasaji:sisasaji@127.0.0.1:5432/sisasaji
# Option C — Neon / managed Postgres (enable PostGIS there), pooled URL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# --- Redis (optional) ---------------------------------------------------------
# Not required: stock locks, presence and jobs run on Postgres + `npm run worker`.
# REDIS_URL=redis://127.0.0.1:6379

# --- App ----------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Security (all required in production, min. 32 chars) ---------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PICKUP_QR_SECRET=
# SESSION_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# --- Login (OTP) --------------------------------------------------------------
# true = OTP code is shown on screen / returned by the API (no WhatsApp provider).
OTP_DEV_MODE=true

# --- Payment ------------------------------------------------------------------
# simulator = demo QRIS with a "Simulasi Bayar" button (signed webhook).
PAYMENT_PROVIDER=simulator

# --- Web Push (optional) ------------------------------------------------------
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@sisasaji.test

# Optional: change the seeder's PRNG seed.
# SEED=20271107
