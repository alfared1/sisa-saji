# Copy to .env and adjust — or run `npm run setup:secrets`, which creates .env
# from this file and fills the empty secret/VAPID lines below (never overwrites).

# --- Database (PostgreSQL 16+ with PostGIS) ---------------------------------
# Option A — no Docker: `npm run db:local` (PGlite + PostGIS on port 5433)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Option B — Docker: `docker compose up -d`
# DATABASE_URL=postgres://sisasaji:sisasaji@127.0.0.1:5432/sisasaji
# Option C — Neon / managed Postgres (enable PostGIS there), pooled URL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# Note: `npm run demo` always uses the local PGlite on DEMO_DB_PORT (default 5433)
# unless DEMO_DATABASE_URL is set.

# --- Redis (optional) ---------------------------------------------------------
# Not required: stock locks, presence and jobs run on Postgres + `npm run worker`.
# REDIS_URL=redis://127.0.0.1:6379

# --- App ----------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Security (all required in production, min. 32 chars) ---------------------
# Empty = dev-only fallback secrets under `npm run dev`; `next start` refuses them.
# Fill with `npm run setup:secrets` (or by hand:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# Changing them later logs everybody out and invalidates existing pickup QR codes
# (re-seed the demo data afterwards).
PICKUP_QR_SECRET=
SESSION_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Login (OTP) --------------------------------------------------------------
# true = OTP code is shown on screen / returned by the API (no WhatsApp provider).
# Default when unset: true in development, false in production (`npm run demo` sets true).
OTP_DEV_MODE=true

# --- Payment ------------------------------------------------------------------
# simulator = demo QRIS with a "Simulasi Bayar" button (signed webhook).
PAYMENT_PROVIDER=simulator

# --- Web Push (optional; push is disabled while the keys are empty) -----------
# Filled by `npm run setup:secrets` (or: npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sisasaji.test

# --- One-command demo (`npm run demo`, optional overrides) --------------------
# DEMO_PORT=3000
# DEMO_DB_PORT=5433
# DEMO_DB_DIR=./.pglite
# DEMO_DATABASE_URL=
# DEMO_BUILD=auto          # auto | always | never
# DEMO_SEED=true           # false = keep the current data

# Optional: change the seeder's PRNG seed.
# SEED=20271107
